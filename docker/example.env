# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables

# The location where your uploaded files are stored
UPLOAD_LOCATION=./library

# The location where your database files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=./postgres

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=Etc/UTC

# The Immich version to use. You can pin this to a specific version like "v2.1.0"
IMMICH_VERSION=v3

# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=postgres

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# === Telegram Storage Configuration ===
# Enable Telegram storage backend
TELEGRAM_STORAGE_ENABLED=false

# API credentials from my.telegram.org
# Register at https://my.telegram.org to get these values
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Session persistence directory (for MTProto authentication)
TELEGRAM_SESSION_DIR=./telegram

# Session file path (inside container)
TELEGRAM_SESSION_PATH=/config/telegram.session

# Target chat/channel ID for storage
# Create a channel and add your bot as admin, then get the chat ID
TELEGRAM_CHAT_ID=

# Enable TDENC2 encryption for files uploaded to Telegram
TELEGRAM_ENCRYPTION_ENABLED=true

# Vault key for encryption (auto-generated if empty)
# WARNING: Keep this key safe! Loss of this key means loss of encrypted data
TELEGRAM_VAULT_KEY=

# Cache settings
TELEGRAM_CACHE_SIZE_MB=5120
TELEGRAM_CACHE_TTL_HOURS=168

# Rate limiting
TELEGRAM_MAX_CONCURRENT_UPLOADS=4
TELEGRAM_MAX_CONCURRENT_DOWNLOADS=8
TELEGRAM_UPLOAD_DELAY_MS=1000

# Multi-account support (optional, for rate limit distribution)
# TELEGRAM_ACCOUNTS=primary,backup1
# TELEGRAM_PRIMARY_API_ID=
# TELEGRAM_PRIMARY_API_HASH=
# TELEGRAM_PRIMARY_SESSION=/config/session-primary
# TELEGRAM_PRIMARY_CHAT_ID=
# TELEGRAM_BACKUP1_API_ID=
# TELEGRAM_BACKUP1_API_HASH=
# TELEGRAM_BACKUP1_SESSION=/config/session-backup1
# TELEGRAM_BACKUP1_CHAT_ID=
